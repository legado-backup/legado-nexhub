{
  "app": {
    "bundleName": "com.nexhub.nexhub",
    "vendor": "nexhub",
    "versionCode": 52,
    "versionName": "3.1.1",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    // 应用分身：同一设备可创建最多 5 个独立实例（独立数据目录），
    // 用于把不同源 / 账号的浏览与阅读数据完全隔离。
    "multiAppMode": {
      "multiAppModeType": "appClone",
      "maxCount": 5
    }
  }
}
